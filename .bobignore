# Files Bob must not read or edit: the credentials of the BAW and PostgreSQL servers.
# Do not list .bob/mcp.json: Bob reads it through this filter at startup and its chat fails to start.
.env
.env.*
!.env.example
db-backups/

# Test fixtures hold prepared answers (such as the Large Group quote spec); Bob builds from the requirement, not from these.
server/tests/
