# BAW server settings and credentials
.env
.env.*
!.env.example

# Bob's local MCP config holds machine-specific paths
.bob/mcp.json

# Working files: exports, specs, builds, screenshots
work/

# Screens written per project by the agent
coach-ui/src/screens/

__pycache__/
*.pyc
.DS_Store
plans/
.engram/

# Client screenshots for the demo: never commit them, the repository is public
screenshots/Quote/

# Backups of database rows, written by the database tools
db-backups/

# The local knowledge graph for Bob and its rule; rebuilt on each machine, never committed
graphify-out/
.bob/rules/graphify.md

# Bob's scratch files, which include dumps of the Word documents it reads (client documents)
.bob/tmp/

# Local audit log
audit.log
