# Copy to .env and fill in. Values already set in the environment (for example the "env"
# block of .bob/mcp.json) take precedence over this file.
BAW_URL=https://cpd-your-cluster.example.com
BAW_USER=your-user
# Set one of these: the user's password, or a Cloud Pak Platform API key.
BAW_PASSWORD=
BAW_APIKEY=

# TLS: the server's certificate is verified by default, for BAW and for PostgreSQL.
# A cluster whose certificate is signed by a private CA: point to that CA's certificate (PEM). A relative
# path starts at the folder that holds this file. The browser test also needs the CA in the system trust store.
# BAW_CA_FILE=
# PostgreSQL only: a different CA file. It defaults to BAW_CA_FILE.
# POSTGRES_CA_FILE=
# PostgreSQL only: disable, allow, prefer, require, verify-ca or verify-full. Default verify-full (prefer
# when BAW_TLS_INSECURE is true). A cluster whose PostgreSQL has SSL off needs prefer; passwords and rows
# then cross the network unencrypted, so use it on a test cluster only.
# POSTGRES_SSLMODE=
# Test clusters only: set to true to skip certificate checks for BAW and the browser test.
# BAW_TLS_INSECURE=false

# Optional: Bob's database tools (list_tables, describe_table, run_sql, export_table, import_table,
# change_system_db). Without POSTGRES_PORT, POSTGRES_USER and POSTGRES_PASSWORD those six tools say what is
# missing; the other tools work as before. The connection is encrypted and the server certificate is checked unless POSTGRES_SSLMODE says otherwise (see the TLS block above).
# The host of BAW_URL is used unless POSTGRES_HOST is set.
# POSTGRES_HOST=
POSTGRES_PORT=
# The PostgreSQL admin login. The server uses it to create Bob's limited login on first use, and for
# change_system_db, which always asks first. Nothing else logs in as the admin.
POSTGRES_USER=
POSTGRES_PASSWORD=
# Bob's limited login (default name bob_mcp). The server adds POSTGRES_BOB_USER and POSTGRES_BOB_PASSWORD
# to this file itself on first use: do not set them.
# The one database Bob may write to, and the role BAW's data source (jdbc/bawexternal) uses there.
# The defaults are bawexternal and that database's owner. Set them only when yours differ.
# POSTGRES_APP_DATABASE=bawexternal
# POSTGRES_APP_ROLE=
